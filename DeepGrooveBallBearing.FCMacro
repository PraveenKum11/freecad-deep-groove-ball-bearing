def wrapped(text, width=50):
    """Break help text into short lines so tooltips stay narrow."""
    return "\n".join(textwrap.fill(para, width) for para in text.split("\n"))


# Catalog sizes for the size picker and the Part label: designation, d (ID), D (OD),
# B (height) and, where it differs, the shielded width (688 is 4 mm open, 5 mm as 688ZZ).
# ISO 15 boundary dimensions of deep groove ball bearings (series 60, 62, 63, 68, 69)
# and metric miniatures (MR), the same table as in the Bearings workbench.
CATALOG = """
