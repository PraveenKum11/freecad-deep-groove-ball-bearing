def _catalog():
    rows = []
    for entry in CATALOG.replace("\n", ",").split(","):
        if entry.strip():
            name, *dims = entry.split()
            d, D, B, *shielded = (float(x) for x in dims)
            rows.append((name, d, D, B, shielded[0] if shielded else None))
    return rows


CATALOG_ROWS = _catalog()


def catalog_rows():
    """Every catalog size once, (designation, d, D, B) sorted by bore then OD."""
    seen, rows = set(), []
    for name, d, D, B, _ in CATALOG_ROWS:
        if (d, D, B) not in seen:
            seen.add((d, D, B))
            rows.append((name, d, D, B))
    return sorted(rows, key=lambda r: (r[1], r[2], r[3]))


def catalog_match(values, tol=1e-6):
    """Designation of the catalog bearing with these ID x OD x Height, or None.

    The height may be the open or the shielded width (688 is 4 mm open, 5 mm as 688ZZ).
    """
    for name, d, D, B, shielded in CATALOG_ROWS:
        if abs(values["ID"] - d) >= tol or abs(values["OD"] - D) >= tol:
            continue
        widths = [B] + ([shielded] if shielded is not None else [])
        if any(abs(values["Height"] - b) < tol for b in widths):
            return name
    return None


# ---------------------------------------------------------------- geometry helpers


def center_of(circle):
    """Circle center (`Center` is deprecated in newer FreeCAD in favour of `Location`)."""
    return App.Vector(circle.Location if hasattr(circle, "Location") else circle.Center)


def is_circular_edge(shape):
    return hasattr(shape, "Curve") and isinstance(shape.Curve, Part.Circle)


def global_placement(obj):
    """Placement of `obj` in document coordinates, through its parent containers."""
    pl = obj.Placement
    parent = obj.getParentGeoFeatureGroup()
    while parent:
        pl = parent.Placement.multiply(pl)
        parent = parent.getParentGeoFeatureGroup()
    return pl


def parent_placement(obj):
    """Placement of the coordinate system `obj` lives in (its containers, not itself)."""
    pl = App.Placement()
    parent = obj.getParentGeoFeatureGroup()
    while parent:
        pl = parent.Placement.multiply(pl)
        parent = parent.getParentGeoFeatureGroup()
    return pl


def resolve_edge(obj, subname):
    """Return (global edge, global shape of the object owning it), or (None, None).

    `subname` is either an element ("Edge3") or a path from `obj` ("Body.Pad.Edge3"), as
    stored in a PropertyLinkSub or returned by getSelectionEx("", 0). The edge is taken
    from the owning shape so the two share topology (needed for ancestorsOfType).
    """
    path, _, element = subname.rpartition(".")
    path = path + "." if path else ""
    try:
        shape = Part.getShape(obj, path) if path else Part.getShape(obj)
        edge = shape.getElement(element)
    except Exception:
        return None, None
    if not is_circular_edge(edge):
        return None, None
    to_global = parent_placement(obj)
    if not to_global.isIdentity():
        shape = shape.copy()
        shape.Placement = to_global.multiply(shape.Placement)
        edge = shape.getElement(element)
    return edge, shape


def owner_object(obj, subname):
    """The object owning the element of `subname`, e.g. the Pad for "Body.Pad.Edge3"."""
    path = subname.rpartition(".")[0]
    return obj.getSubObject(path + ".", retType=1) if path else obj


def frame_placement(edge, axial_offset=0.0):
    """Global placement with X radial (through the edge), Z along the edge's axis,
    origin on the axis shifted `axial_offset` from the edge's plane."""
    circle = edge.Curve
    axis = App.Vector(circle.Axis).normalize()
    origin = center_of(circle) + axis * axial_offset

    # Radial direction: from the center to a point on the edge, with any axial part removed
    radial = edge.valueAt(edge.FirstParameter) - center_of(circle)
    radial = radial - axis * radial.dot(axis)
    radial.normalize()
    y = axis.cross(radial)

    # fmt: off
    return App.Placement(
        App.Matrix(
            radial.x, y.x, axis.x, origin.x,
            radial.y, y.y, axis.y, origin.y,
            radial.z, y.z, axis.z, origin.z,
            0, 0, 0, 1,
        )
    )


def outward_normal(shape, edge):
    """Normal of a planar face bounded by `edge`, pointing out of the material.

    Falls back to the circle axis when no planar face shares the edge.
    """
    try:
        faces = shape.ancestorsOfType(edge, Part.Face)
    except Part.OCCError:
        # edge is not a sub-shape of `shape` (e.g. a copy): match faces by geometry
        faces = [
            f for f in shape.Faces if any(e.isSame(edge) or _same_circle(e, edge) for e in f.Edges)
        ]
    for face in faces:
        if isinstance(face.Surface, Part.Plane):
            u0, u1, v0, v1 = face.ParameterRange
            return face.normalAt((u0 + u1) / 2, (v0 + v1) / 2).normalize()
    return App.Vector(edge.Curve.Axis).normalize()


def _same_circle(a, b, tol=1e-6):
    if not (is_circular_edge(a) and is_circular_edge(b)):
        return False
    return (
        abs(a.Curve.Radius - b.Curve.Radius) < tol
        and (center_of(a.Curve) - center_of(b.Curve)).Length < tol
    )


def coaxial_cylinders(solid, edge):
    """Cylindrical faces of `solid` on the edge's axis, as (face, radius) pairs."""
    circle = edge.Curve
    center = center_of(circle)
    axis = App.Vector(circle.Axis).normalize()
    found = []
    for face in solid.Faces:
        surf = face.Surface
        if not isinstance(surf, Part.Cylinder):
            continue
        if abs(abs(App.Vector(surf.Axis).normalize().dot(axis)) - 1) > TOL:
            continue
        offset = center_of(surf) - center
        if (offset - axis * offset.dot(axis)).Length > 1e-4:
            continue  # parallel but not on the bearing axis
        found.append((face, surf.Radius))
    return found


def cylinder_side(solid, edge):
    """Find the cylindrical face the circular edge bounds and which side its material is on.

    Returns (side, lo, hi): side is "outside" for a bore (material radially outside the
    cylinder) or "inside" for a shaft / outer surface; lo..hi is the face's axial range
    measured from the edge's plane. (None, 0, 0) if there is no such face.
    """
    circle = edge.Curve
    center = center_of(circle)
    axis = App.Vector(circle.Axis).normalize()
    radial = edge.valueAt(edge.FirstParameter) - center
    radial = radial - axis * radial.dot(axis)
    radial.normalize()
    eps = min(0.01, circle.Radius * 0.01)

    for face, radius in coaxial_cylinders(solid, edge):
        if abs(radius - circle.Radius) > 1e-4:
            continue
        heights = [(v.Point - center).dot(axis) for v in face.Vertexes]
        if min(abs(h) for h in heights) > 1e-4:
            continue  # same diameter, but not the face this edge belongs to
        lo, hi = min(heights), max(heights)
        on_face = center + axis * ((lo + hi) / 2) + radial * circle.Radius
        outside = solid.isInside(on_face + radial * eps, 1e-7, False)
        inside = solid.isInside(on_face - radial * eps, 1e-7, False)
        if outside != inside:
            return ("outside" if outside else "inside"), lo, hi
    return None, 0.0, 0.0


def nearest_solid(shape, edge):
    return min(shape.Solids, key=lambda s: s.distToShape(edge)[0])


def edge_side(shape, edge):
    """ "outside" (a bore / hole), "inside" (a shaft / outer surface) or None."""
    if shape is None or not shape.Solids:
        return None
    return cylinder_side(nearest_solid(shape, edge), edge)[0]


def find_body(feature):
    """Return the PartDesign Body the selected feature belongs to, or None."""
    if feature.TypeId == "PartDesign::Body":
        return feature
    parent = feature.getParentGeoFeatureGroup()
    if parent and parent.TypeId == "PartDesign::Body":
        return parent
    return None


def measure_body(body, edge):
    """Measure the selected body around the edge, for grooving it into races.

    `edge` is in document coordinates. Returns the edge's diameter, whether it is the
    bearing's ID (a bore) or OD (an outer surface), the selected cylinder's length and
    the axial offset of its middle from the edge's plane.
    """
    # body.Shape includes the body's own placement but not its containers' (App::Part),
    # so bring the edge into the body's container coordinates first
    container = global_placement(body).multiply(body.Placement.inverse())
    edge = edge.copy()
    edge.transformShape(container.inverse().toMatrix())

    solid = nearest_solid(body.Shape, edge)
    side, lo, hi = cylinder_side(solid, edge)
    if side is None:
        raise ValueError("Could not find the cylindrical face of the selected edge on the body.")
    return {
        "dia": 2 * edge.Curve.Radius,
        "is_inner": side == "outside",  # a bore is the bearing's inner diameter
        "height": hi - lo,
        "mid": (lo + hi) / 2,
    }


def origin_feature(body, role):
    return next(f for f in body.Origin.OriginFeatures if f.Role == role)


def attach(sketch, target, mode="FlatFace"):
    prop = "AttachmentSupport" if hasattr(sketch, "AttachmentSupport") else "Support"
    setattr(sketch, prop, [(target, "")])
    sketch.MapMode = mode


def max_balls(id_, od, ball_dia, clearance=0.0):
    """Most pockets that fit around the pitch circle without overlapping."""
    ratio = (ball_dia + clearance) / ((id_ + od) / 2)
    return int(math.pi / math.asin(ratio)) if ratio < 1 else 0


def other_diameter(selected, selected_is_inner):
    """Starting value for the diameter the selected edge doesn't fix: 15 mm larger for a
    selected ID; 15 mm smaller for a selected OD, or half of it when that leaves no bore."""
    if selected_is_inner:
        return round(selected + OTHER_DIAMETER_OFFSET, 2)
    smaller = selected - OTHER_DIAMETER_OFFSET
    return round(smaller if smaller > 0 else selected / 2, 2)


def validate(v, cage=False, balls=False):
    id_, od, height, ball = v["ID"], v["OD"], v["Height"], v["BallDiameter"]
    for name, label in (
        ("ID", "Inner diameter"),
        ("Height", "Height"),
        ("BallDiameter", "Ball diameter"),
    ):
        if v[name] <= 0:
            raise ValueError("%s must be greater than 0." % label)
    if od <= id_:
        raise ValueError("Outer diameter must be larger than the inner diameter.")
    if ball >= (od - id_) / 2:
        raise ValueError(
            "Ball diameter Ø%.2f must be smaller than the ring wall (%.2f)."
            % (ball, (od - id_) / 2)
        )
    if ball >= height:
        raise ValueError(
            "Ball diameter Ø%.2f must be smaller than the height (%.2f)." % (ball, height)
        )
    if balls or cage:
        clearance = v["PocketClearance"] if cage else 0.0
        n = max_balls(id_, od, ball, clearance)
        if not 1 <= v.get("NumBalls", DEFAULT_NUM_BALLS) <= n:
            raise ValueError("Number of balls must be between 1 and %d for these sizes." % n)
    if not cage:
        return
    if v["CageThickness"] <= 0:
        raise ValueError("Cage thickness must be greater than 0.")
    if v["CageThickness"] > ball / 2 + 1e-9:
        raise ValueError(
            "Cage thickness %.2f can be at most the gap between the races "
            "(half the ball diameter, %.2f)." % (v["CageThickness"], ball / 2)
        )
    if ball * SIN60 / 2 - v["CageTopOffset"] <= -height / 2:
        raise ValueError("Cage top offset %.2f leaves no cage." % v["CageTopOffset"])


# ---------------------------------------------------------------- shared profile geometry

# The groove and cage dimensions are computed once here, for both the PartDesign
# features (initial sketch geometry) and the dialog's preview. The sketches are then
# driven by expressions on BearingParameters, which repeat these formulas.


def groove_profile(v):
    """Groove profile dimensions in the bearing frame (X radial, Y = Z axial, origin on
    the axis at mid-height): pitch radius rp, ball radius rb, half slot width w, half
    height h, and yi, the height where the slot walls meet the ball circle."""
    ball = v["BallDiameter"]
    return {
        "rp": (v["ID"] + v["OD"]) / 4,  # ball center
        "rb": ball / 2,
        "w": ball / 4,  # slot = ball diameter / 2
        "h": v["Height"] / 2,
        "yi": ball / 2 * SIN60,
    }


def cage_profile(v):
    """Cage ring cross-section (r_in, r_out, bottom, top) in the bearing frame.

    As designed the cage reaches from the bottom face to CageTopOffset below where the
    slot walls meet the ball, with the pocket rising PocketRise above its top. It is
    shown seated: shifted along the axis so the pocket center lands on the ball center.
    """
    g = groove_profile(v)
    t = v["CageThickness"]
    design_top = g["yi"] - v["CageTopOffset"]
    top = (v["BallDiameter"] + v["PocketClearance"]) / 2 - v["PocketRise"]
    bottom = -g["h"] + (top - design_top)
    return g["rp"] - t / 2, g["rp"] + t / 2, bottom, top


def _xz(x, z):
    return V(x, 0, z)


def _profile_face(items):
    """Build a closed planar face in the XZ plane.

    items: ('p', x, z, fillet_r) corner points and ('a', x, z) arc mid points. An 'a'
    item makes the segment between its neighbouring points an arc through (x, z).
    A fillet is applied only where both adjacent segments are straight.
    """
    n = len(items)
    entry, exit_, fillet_arc = {}, {}, {}
    for i, it in enumerate(items):
        if it[0] != "p":
            continue
        p = _xz(it[1], it[2])
        entry[i] = exit_[i] = p
        r = it[3]
        prv, nxt = items[i - 1], items[(i + 1) % n]
        if r <= 0 or prv[0] != "p" or nxt[0] != "p":
            continue
        a, c = _xz(prv[1], prv[2]), _xz(nxt[1], nxt[2])
        la, lc = (a - p).Length, (c - p).Length
        u1, u2 = (a - p).normalize(), (c - p).normalize()
        theta = math.acos(max(-1.0, min(1.0, u1.dot(u2))))
        if theta < 1e-6 or theta > math.pi - 1e-6:
            continue
        # keep the trimmed points on the edges (leave room for the neighbour's fillet)
        r = min(r, 0.45 * min(la, lc) * math.tan(theta / 2))
        t = r / math.tan(theta / 2)
        bis = (u1 + u2).normalize()
        center = p + bis * (r / math.sin(theta / 2))
        entry[i] = p + u1 * t
        exit_[i] = p + u2 * t
        fillet_arc[i] = center - bis * r

    edges = []
    for i, it in enumerate(items):
        if it[0] != "p":
            continue
        if i in fillet_arc:
            edges.append(Part.Arc(entry[i], fillet_arc[i], exit_[i]).toShape())
        j = (i + 1) % n
        if items[j][0] == "p":
            if (entry[j] - exit_[i]).Length > 1e-9:
                edges.append(Part.LineSegment(exit_[i], entry[j]).toShape())
        else:
            k = (j + 1) % n
            mid = _xz(items[j][1], items[j][2])
            edges.append(Part.Arc(exit_[i], mid, entry[k]).toShape())
    return Part.Face(Part.Wire(edges))


def revolve(items):
    """Solid of revolution about Z of a _profile_face() profile in the XZ plane."""
    face = _profile_face(items)
    return Part.Solid(face.revolve(V(0, 0, 0), V(0, 0, 1), 360))


# ---------------------------------------------------------------- features


def make_params(body, values, placement, readonly=()):
    """BearingParameters datum inside the races Body: the bearing frame + all parameters.

    `placement` is in body coordinates (origin on the axis at mid-height, Z = axis).
    Names in `readonly` (the diameter taken from the selected edge) can't be edited.
    """
    lcs = body.newObject("PartDesign::CoordinateSystem", PARAMS)
    lcs.MapMode = "Deactivated"
    lcs.Placement = placement
    for name, doc_str in BEARING_DOCS.items():
        if name in readonly:
            doc_str += " (taken from the selected edge)"
        kind = "App::PropertyInteger" if name == "NumBalls" else "App::PropertyLength"
        lcs.addProperty(kind, name, "Bearing", wrapped(doc_str))
        setattr(
            lcs,
            name,
            values.get(name, DEFAULT_NUM_BALLS) if name == "NumBalls" else values[name],
        )
        if name in readonly:
            lcs.setEditorMode(name, ["ReadOnly"])
    for name, default in CAGE_DEFAULTS.items():
        lcs.addProperty("App::PropertyLength", name, "Cage", wrapped(CAGE_DOCS[name]))
        setattr(lcs, name, values.get(name, default))
    lcs.Visibility = False
    return lcs


def values_of(params):
    names = tuple(BEARING_DOCS) + tuple(CAGE_DEFAULTS)
    return {n: getattr(params, n).Value if n != "NumBalls" else params.NumBalls for n in names}


def draw_race_profile(sketch, v):
    """Ball circle + slot through the full height, as in deep-groove-bb.FCStd.

    Origin at mid-height on the axis. Driving constraints are named
    PitchRadius, BallDiameter, SlotWidth, Height.
    """
    V = App.Vector
    Z = V(0, 0, 1)
    g = groove_profile(v)
    rp, rb, w, h, yi = g["rp"], g["rb"], g["w"], g["h"], g["yi"]
    phi = math.atan2(yi, w)

    def line(x1, y1, x2, y2):
        return sketch.addGeometry(Part.LineSegment(V(x1, y1, 0), V(x2, y2, 0)))

    def arc(a1, a2):
        return sketch.addGeometry(Part.ArcOfCircle(Part.Circle(V(rp, 0, 0), Z, rb), a1, a2))

    ball = sketch.addGeometry(Part.Circle(V(rp, 0, 0), Z, rb), True)
    l1 = line(rp - w, -yi, rp - w, -h)  # bottom slot, inner wall
    l2 = line(rp - w, -h, rp + w, -h)  # bottom face
    l3 = line(rp + w, -h, rp + w, -yi)  # bottom slot, outer wall
    l4 = line(rp - w, yi, rp - w, h)  # top slot, inner wall
    l5 = line(rp - w, h, rp + w, h)  # top face
    l6 = line(rp + w, h, rp + w, yi)  # top slot, outer wall
    a_in = arc(math.pi - phi, math.pi + phi)  # ball arc into the inner race
    a_out = arc(-phi, phi)  # ball arc into the outer race

    C = Sketcher.Constraint
    named = {
        "PitchRadius": C("DistanceX", -1, 1, ball, 3, rp),
        "BallDiameter": C("Diameter", ball, 2 * rb),
        "SlotWidth": C("DistanceX", l2, 1, l2, 2, 2 * w),
        "Height": C("DistanceY", l2, 1, l5, 1, 2 * h),
    }
    for name, con in named.items():
        sketch.renameConstraint(sketch.addConstraint(con), name)

    sketch.addConstraint(
        [
            # Ball center on the mid-height line
            C("PointOnObject", ball, 3, -1),
            # Ball arcs follow the ball circle
            C("Coincident", a_in, 3, ball, 3),
            C("Coincident", a_out, 3, ball, 3),
            C("Equal", a_in, ball),
            C("Equal", a_out, ball),
            # Closed outline
            C("Coincident", l1, 2, l2, 1),
            C("Coincident", l2, 2, l3, 1),
            C("Coincident", l4, 2, l5, 1),
            C("Coincident", l5, 2, l6, 1),
            C("Coincident", a_in, 1, l4, 1),
            C("Coincident", a_in, 2, l1, 1),
            C("Coincident", a_out, 1, l3, 2),
            C("Coincident", a_out, 2, l6, 2),
            C("Vertical", l1),
            C("Vertical", l3),
            C("Vertical", l4),
            C("Vertical", l6),
            C("Horizontal", l2),
            C("Horizontal", l5),
            # Slot centered on the ball
            C("Equal", l2, l5),
            C("Vertical", l2, 1, l5, 1),
            C("Symmetric", l2, 1, l5, 2, ball, 3),
        ]
    )


def make_groove(body, params):
    """Groove the race profile around the bearing axis, on the datum's XZ plane."""
    v = values_of(params)
    p = params.Name
    sketch = body.newObject("Sketcher::SketchObject", "BearingSketch")
    attach(sketch, params, "ObjectXZ")
    draw_race_profile(sketch, v)
    for name, expr in (
        ("PitchRadius", "(%s.ID + %s.OD) / 4" % (p, p)),
        ("BallDiameter", p + ".BallDiameter"),
        ("SlotWidth", p + ".BallDiameter / 2"),
        ("Height", p + ".Height"),
    ):
        sketch.setExpression(".Constraints." + name, expr)

    groove = body.newObject("PartDesign::Groove", "BearingGroove")
    groove.Profile = sketch
    groove.ReferenceAxis = (sketch, ["V_Axis"])
    groove.Angle = 360.0
    sketch.Visibility = False
    return groove


def make_cage(doc, races, params):
    """Snap-in cage between the races, in its own Body that follows the bearing frame."""
    v = values_of(params)
    p = params.Name
    r_in, r_out, bottom, top = cage_profile(v)
    pocket_d = v["BallDiameter"] + v["PocketClearance"]

    body = doc.addObject("PartDesign::Body", "Cage")
    follow_bearing(body, races, params)

    # Cage ring cross-section on XZ: X radial, Y = bearing axis
    V = App.Vector
    C = Sketcher.Constraint
    ring = body.newObject("Sketcher::SketchObject", "CageSketch")
    attach(ring, origin_feature(body, "XZ_Plane"))
    pts = [V(r_in, bottom, 0), V(r_out, bottom, 0), V(r_out, top, 0), V(r_in, top, 0)]
    lines = [ring.addGeometry(Part.LineSegment(pts[i], pts[(i + 1) % 4])) for i in range(4)]
    ring.addConstraint(
        [C("Coincident", lines[i], 2, lines[(i + 1) % 4], 1) for i in range(4)]
        + [
            C("Horizontal", lines[0]),
            C("Horizontal", lines[2]),
            C("Vertical", lines[1]),
            C("Vertical", lines[3]),
        ]
    )
    # the expressions of cage_profile()
    design_top_expr = "(%s.BallDiameter * sqrt(3) / 4 - %s.CageTopOffset)" % (p, p)
    top_expr = "(%s.BallDiameter + %s.PocketClearance) / 2 - %s.PocketRise" % (p, p, p)
    for name, con, expr in (
        (
            "CageInner",
            C("DistanceX", -1, 1, lines[0], 1, r_in),
            "(%s.ID + %s.OD) / 4 - %s.CageThickness / 2" % (p, p, p),
        ),
        (
            "CageThickness",
            C("DistanceX", lines[0], 1, lines[0], 2, r_out - r_in),
            p + ".CageThickness",
        ),
        (
            "CageBottom",
            C("DistanceY", -1, 1, lines[0], 1, bottom),
            "-%s.Height / 2 + (%s) - %s" % (p, top_expr, design_top_expr),
        ),
        ("CageTop", C("DistanceY", -1, 1, lines[2], 1, top), top_expr),
    ):
        ring.renameConstraint(ring.addConstraint(con), name)
        ring.setExpression(".Constraints." + name, expr)

    rev = body.newObject("PartDesign::Revolution", "CageRing")
    rev.Profile = ring
    rev.ReferenceAxis = (ring, ["V_Axis"])
    rev.Angle = 360.0
    ring.Visibility = False

    # Ball pocket on YZ (normal = radial X), cut outward through the cage at +X
    pk = body.newObject("Sketcher::SketchObject", "PocketSketch")
    attach(pk, origin_feature(body, "YZ_Plane"))
    circle = pk.addGeometry(Part.Circle(V(0, 0, 0), V(0, 0, 1), pocket_d / 2))
    pk.addConstraint(C("Coincident", circle, 3, -1, 1))  # centered on the ball (seated cage)
    c = pk.addConstraint(C("Diameter", circle, pocket_d))
    pk.renameConstraint(c, "PocketDiameter")
    pk.setExpression(".Constraints.PocketDiameter", "%s.BallDiameter + %s.PocketClearance" % (p, p))

    pocket = body.newObject("PartDesign::Pocket", "BallPocket")
    pocket.Profile = pk
    pocket.Type = "ThroughAll"
    pocket.Reversed = True  # cut toward +X only, so a single pocket per ball
    pk.Visibility = False

    pattern = body.newObject("PartDesign::PolarPattern", "BallPockets")
    pattern.Originals = [pocket]
    pattern.Axis = (origin_feature(body, "Z_Axis"), [""])
    pattern.Angle = 360.0
    pattern.setExpression("Occurrences", p + ".NumBalls")
    body.Tip = pattern  # patterns don't become the tip on their own
    return body


def follow_bearing(body, races, params):
    """Make `body` follow the bearing frame (races Body placement x datum placement).

    The body goes in the same container (e.g. App::Part) as the races, since the
    placements are relative to it.
    """
    container = races.getParentGeoFeatureGroup()
    if container:
        container.addObject(body)
    body.Placement = races.Placement.multiply(params.Placement)
    body.setExpression("Placement", "%s.Placement * %s.Placement" % (races.Name, params.Name))


def make_balls(doc, races, params):
    """One sphere at the pitch diameter, mid-height, patterned NumBalls times, in its own Body."""
    v = values_of(params)
    p = params.Name
    body = doc.addObject("PartDesign::Body", "Balls")
    follow_bearing(body, races, params)

    ball = body.newObject("PartDesign::AdditiveSphere", "Ball")
    attach(ball, origin_feature(body, "XY_Plane"))
    ball.Radius = v["BallDiameter"] / 2
    ball.setExpression("Radius", p + ".BallDiameter / 2")
    ball.AttachmentOffset = App.Placement(App.Vector((v["ID"] + v["OD"]) / 4, 0, 0), App.Rotation())
    ball.setExpression(".AttachmentOffset.Base.x", "(%s.ID + %s.OD) / 4" % (p, p))

    pattern = body.newObject("PartDesign::PolarPattern", "BallPattern")
    pattern.Originals = [ball]
    pattern.Axis = (origin_feature(body, "Z_Axis"), [""])
    pattern.Angle = 360.0
    pattern.setExpression("Occurrences", p + ".NumBalls")
    body.Tip = pattern  # patterns don't become the tip on their own
    return body


def check(doc, *features):
    doc.recompute()
    for f in features:
        if not f.isValid():
            raise RuntimeError("%s failed: %s" % (f.Label, f.getStatusString()))


def groove_body(feature, edge, values, cage=True, balls=False):
    """Groove the body the edge belongs to, so the body itself becomes the races.

    The edge's diameter (ID on a bore, OD on an outer surface) replaces the one in
    `values`; the other diameter and Height in `values` set where the groove goes,
    centered on the selected cylinder. `edge` must be in global coordinates.
    """
    doc = feature.Document
    body = find_body(feature)
    if body is None:
        raise ValueError("To groove the selected body, the edge must belong to a PartDesign Body.")
    m = measure_body(body, edge)
    key = "ID" if m["is_inner"] else "OD"
    values = dict(values, **{key: m["dia"]})
    validate(values, cage, balls)

    # Bearing frame (on the axis, mid-way along the selected cylinder), in body coordinates
    frame = global_placement(body).inverse().multiply(frame_placement(edge, m["mid"]))
    params = make_params(body, values, frame, readonly=(key,))

    feats = [make_groove(body, params)]
    if cage:
        feats.append(make_cage(doc, body, params).Tip)
    if balls:
        feats.append(make_balls(doc, body, params).Tip)
    check(doc, *feats)
    return params


def bearing_label(values):
    """Part label with the bearing's size, OD x ID x Height, e.g. "Bearing 32x20x8".

    A catalog size is named too: "Bearing 608 (22x8x7)".
    """

    def num(x):
        return ("%.2f" % x).rstrip("0").rstrip(".")

    size = "%sx%sx%s" % (num(values["OD"]), num(values["ID"]), num(values["Height"]))
    name = catalog_match(values)
    return "Bearing %s (%s)" % (name, size) if name else "Bearing " + size


def create_races(doc, placement, values, reverse=False, cage=True, balls=False):
    """Build a parametric ring blank, then groove it into two races.

    `placement` is the global frame of the bearing: Z = axis, origin = one face center.
    The ring is padded along +Z (or -Z when `reverse`). The races, cage and balls bodies
    go into one App::Part (labelled by bearing_label()) that carries this placement.
    """
    validate(values, cage, balls)
    part = doc.addObject("App::Part", "Bearing")
    part.Label = bearing_label(values)
    part.Placement = placement
    body = doc.addObject("PartDesign::Body", "Races")
    part.addObject(body)  # the cage and balls bodies join it (follow_bearing)

    # Datum at mid-height; it follows Height so the frame stays centered
    params = make_params(
        body,
        values,
        App.Placement(
            App.Vector(0, 0, (-0.5 if reverse else 0.5) * values["Height"]),
            App.Rotation(),
        ),
    )
    params.setExpression(".Placement.Base.z", "%sHeight / 2" % ("-" if reverse else ""))
    p = params.Name

    # Ring blank: two circles padded to the bearing height
    ring = body.newObject("Sketcher::SketchObject", "RingSketch")
    attach(ring, origin_feature(body, "XY_Plane"))
    for name in ("ID", "OD"):
        g = ring.addGeometry(Part.Circle(App.Vector(), App.Vector(0, 0, 1), values[name] / 2))
        ring.addConstraint(Sketcher.Constraint("Coincident", g, 3, -1, 1))
        ring.renameConstraint(
            ring.addConstraint(Sketcher.Constraint("Diameter", g, values[name])), name
        )
        ring.setExpression(".Constraints." + name, "%s.%s" % (p, name))

    pad = body.newObject("PartDesign::Pad", "Blank")
    pad.Profile = ring
    pad.Reversed = reverse
    pad.setExpression("Length", p + ".Height")
    ring.Visibility = False

    feats = [make_groove(body, params)]
    if cage:
        feats.append(make_cage(doc, body, params).Tip)
    if balls:
        feats.append(make_balls(doc, body, params).Tip)
    check(doc, *feats)
    return params


# ---------------------------------------------------------------- preview


def preview_shapes(v, cage=True):
    """Light Part shapes of the bearing, in the bearing frame (origin on the axis at
    mid-height, Z = axis), for the task panel preview: [(role, shape), ...].

    Same groove_profile() and cage_profile() as the PartDesign features, but revolved
    directly from 2D profiles (no booleans, no cage pockets) so it is fast enough to
    rebuild on every edit. Returns [] when the values can't be drawn.
    """
    id_, od, height, ball = v["ID"], v["OD"], v["Height"], v["BallDiameter"]
    if not (0 < id_ < od and height > 0 and 0 < ball < min((od - id_) / 2, height)):
        return []
    g = groove_profile(v)
    rp, rb, w, h, yi = g["rp"], g["rb"], g["w"], g["h"], g["yi"]
    inner = [
        ("p", id_ / 2, -h, 0),
        ("p", rp - w, -h, 0),
        ("p", rp - w, -yi, 0),
        ("a", rp - rb, 0),  # ball arc into the inner race
        ("p", rp - w, yi, 0),
        ("p", rp - w, h, 0),
        ("p", id_ / 2, h, 0),
    ]
    outer = [
        ("p", rp + w, -h, 0),
        ("p", od / 2, -h, 0),
        ("p", od / 2, h, 0),
        ("p", rp + w, h, 0),
        ("p", rp + w, yi, 0),
        ("a", rp + rb, 0),  # ball arc into the outer race
        ("p", rp + w, -yi, 0),
    ]
    try:
        shapes = [("inner race", revolve(inner)), ("outer race", revolve(outer))]
        n = max(1, int(v.get("NumBalls", DEFAULT_NUM_BALLS)))
        sphere = Part.makeSphere(rb, App.Vector(rp, 0, 0))
        for k in range(n):
            s = sphere.copy()
            s.rotate(App.Vector(), App.Vector(0, 0, 1), 360.0 * k / n)
            shapes.append(("ball", s))
        if cage and 0 < v["CageThickness"] <= rb + 1e-9:
            r_in, r_out, bottom, top = cage_profile(v)
            if top > bottom:
                ring = [(r_in, bottom), (r_out, bottom), (r_out, top), (r_in, top)]
                shapes.append(("cage", revolve([("p", x, z, 0) for x, z in ring])))
    except Part.OCCError:
        return []
    return shapes


def preview_frame(mode, edge, measured, height, reverse=False):
    """Global placement of the bearing frame (origin on the axis at mid-height) that
    groove_body() / create_races() would use."""
    if mode == GROOVE:
        return frame_placement(edge, measured["mid"])
    face = frame_placement(edge) if edge is not None else App.Placement()
    return face.multiply(
        App.Placement(App.Vector(0, 0, (-0.5 if reverse else 0.5) * height), App.Rotation())
    )


# ---------------------------------------------------------------- GUI

if App.GuiUp:
    import FreeCADGui as Gui
    from PySide import QtCore, QtGui


PREVIEW_COLORS = {
    "inner race": (0.35, 0.55, 0.85),
    "outer race": (0.35, 0.55, 0.85),
    "ball": (0.85, 0.2, 0.2),
    "cage": (0.95, 0.55, 0.1),
}


RING_COLORS = {"ID": (0.1, 0.75, 0.25), "OD": (0.9, 0.2, 0.75)}


class Preview:
    """Temporary scene-graph overlay in the active 3D view; never added to the document.

    Shows the ID and OD as labelled rings on both faces (drawn on top, so they are
    visible through the part) and a translucent ghost of races, balls and cage.
    """

    active = None  # the preview currently on screen, so a stale one can always be removed

    def __init__(self):
        from pivy import coin

        self.coin = coin
        self.view = Gui.ActiveDocument.ActiveView if Gui.ActiveDocument else None
        self.root = None

    @classmethod
    def clear_stale(cls):
        if cls.active is not None:
            cls.active.clear()

    def clear(self, *_):
        if self.root is not None and self.view is not None:
            try:
                self.view.getSceneGraph().removeChild(self.root)
            except Exception:
                pass  # the view may already be gone (document closed)
        self.root = None
        if Preview.active is self:
            Preview.active = None

    def show(self, placement, values, cage=True):
        self.clear()
        if self.view is None:
            return
        coin = self.coin
        root = coin.SoSeparator()
        xf = coin.SoTransform()
        xf.translation.setValue(*placement.Base)
        q = placement.Rotation.Q
        xf.rotation.setValue(coin.SbRotation(q[0], q[1], q[2], q[3]))
        root.addChild(xf)

        ghost = coin.SoSeparator()
        hints = coin.SoShapeHints()
        hints.vertexOrdering = coin.SoShapeHints.COUNTERCLOCKWISE
        hints.creaseAngle = 0.6
        ghost.addChild(hints)
        tol = max(0.01, values["OD"] / 300)
        for role, shape in preview_shapes(values, cage):
            ghost.addChild(self._mesh(shape, PREVIEW_COLORS[role], tol))
        root.addChild(ghost)

        rings = coin.SoAnnotation()  # drawn on top of everything
        style = coin.SoDrawStyle()
        style.lineWidth = 3
        rings.addChild(style)
        h = values["Height"] / 2
        for key in ("ID", "OD"):
            r = values[key] / 2
            if r <= 0:
                continue
            for z in (-h, h):
                rings.addChild(self._ring(r, z, RING_COLORS[key]))
            rings.addChild(
                self._label("%s Ø%.2f" % (key, values[key]), r, h, RING_COLORS[key], key == "ID")
            )
        root.addChild(rings)

        self.view.getSceneGraph().addChild(root)
        self.root = root
        Preview.active = self

    def _mesh(self, shape, rgb, tol):
        coin = self.coin
        points, triangles = shape.tessellate(tol)
        sep = coin.SoSeparator()
        mat = coin.SoMaterial()
        mat.diffuseColor.setValue(*rgb)
        mat.transparency.setValue(0.55)
        sep.addChild(mat)
        coords = coin.SoCoordinate3()
        coords.point.setValues(0, len(points), [(p.x, p.y, p.z) for p in points])
        sep.addChild(coords)
        faces = coin.SoIndexedFaceSet()
        index = []
        for a, b, c in triangles:
            index.extend((a, b, c, -1))
        faces.coordIndex.setValues(0, len(index), index)
        sep.addChild(faces)
        return sep

    def _ring(self, r, z, rgb, segments=96):
        import math

        coin = self.coin
        sep = coin.SoSeparator()
        mat = coin.SoBaseColor()
        mat.rgb.setValue(*rgb)
        sep.addChild(mat)
        pts = [
            (r * math.cos(2 * math.pi * i / segments), r * math.sin(2 * math.pi * i / segments), z)
            for i in range(segments + 1)
        ]
        coords = coin.SoCoordinate3()
        coords.point.setValues(0, len(pts), pts)
        sep.addChild(coords)
        line = coin.SoLineSet()
        line.numVertices.setValue(len(pts))
        sep.addChild(line)
        return sep

    def _label(self, text, r, h, rgb, inner):
        import math

        coin = self.coin
        sep = coin.SoSeparator()
        color = coin.SoBaseColor()
        color.rgb.setValue(*rgb)
        sep.addChild(color)
        # ID label on one side, OD label on the opposite side, both on the top face and
        # just outside their ring so the text doesn't sit on the line
        a = math.radians(150 if inner else -30)
        rr = r * 1.06 + 0.5
        pos = coin.SoTranslation()
        pos.translation.setValue(rr * math.cos(a), rr * math.sin(a), h)
        sep.addChild(pos)
        font = coin.SoFont()
        font.size = 20
        sep.addChild(font)
        txt = coin.SoText2()
        txt.string = text
        sep.addChild(txt)
        return sep


class TaskPanel:
    """One task panel for both modes."""

    def __init__(
        self,
        edge=None,
        measured=None,
        create_inner=True,
        reverse=False,
        feature=None,
        body=None,
    ):
        """`edge`: the selected circular edge (global), or None.
        `measured`: measure_body() result if the selected body can be grooved, else None.
        `create_inner`: default for "Selected edge is" when creating races.
        `reverse`: default for "Reverse direction" (set so the races go into the material).
        `feature`, `body`: the object owning the edge and its PartDesign Body (or None)."""
        self.edge, self.measured, self.create_inner = edge, measured, create_inner
        self.feature, self.body = feature, body
        self._mode = None
        self.edge_dia = 2 * edge.Curve.Radius if edge else None

        self.form = QtGui.QWidget()
        self.form.setWindowTitle(TITLE)
        form = QtGui.QFormLayout(self.form)

        def row(layout, label, widget, help_text):
            """Add a form row whose label and field both carry the help text as a tooltip."""
            help_text = wrapped(help_text)
            widget.setToolTip(help_text)
            if label is None:
                layout.addRow(widget)
                return
            lbl = QtGui.QLabel(label)
            lbl.setToolTip(help_text)
            layout.addRow(lbl, widget)

        def spin(value, prefix="Ø "):
            s = QtGui.QDoubleSpinBox()
            s.setDecimals(2)
            s.setSingleStep(0.01)  # arrow keys / buttons step by the last shown digit
            s.setAccelerated(True)  # holding an arrow speeds up
            s.setRange(0.0, 10000)
            s.setPrefix(prefix)
            s.setSuffix(" mm")
            s.setValue(value)
            # report a typed value only on Enter / leaving the field (arrows step at once),
            # so nothing recomputes on every keystroke
            s.setKeyboardTracking(False)
            return s

        self.mode = QtGui.QComboBox()
        if measured:
            self.mode.addItem(GROOVE)
        self.mode.addItem(CREATE)
        row(form, "Races:", self.mode, UI_HELP["Races"])

        self.edge_is = QtGui.QComboBox()
        self.edge_is.addItems(["Inner diameter", "Outer diameter"])
        if edge:
            row(form, "Selected edge (Ø %.2f) is:" % self.edge_dia, self.edge_is, UI_HELP["EdgeIs"])

        self.size = QtGui.QComboBox()
        row(form, "Catalog size:", self.size, UI_HELP["Size"])

        d = self.edge_dia or 20.0
        self.id_ = spin(d)
        self.od = spin(other_diameter(d, True))
        self.height = spin(DEFAULT_HEIGHT, prefix="")
        row(form, "Inner diameter:", self.id_, BEARING_DOCS["ID"])
        row(form, "Outer diameter:", self.od, BEARING_DOCS["OD"])
        row(form, "Height:", self.height, BEARING_DOCS["Height"])

        self.reverse = QtGui.QCheckBox("Reverse direction")
        self.reverse.setChecked(reverse)
        row(form, "", self.reverse, UI_HELP["Reverse"])

        self.ball_preset = QtGui.QComboBox()
        self.ball_preset.addItem(CUSTOM)
        for label, dia in BALL_PRESETS:
            self.ball_preset.addItem(label, dia)
        row(form, "Ball preset:", self.ball_preset, UI_HELP["BallPreset"])
        self.ball = spin(DEFAULT_BALL_DIAMETER)
        row(form, "Ball diameter:", self.ball, UI_HELP["BallDiameter"])
        self.num_balls = QtGui.QSpinBox()
        self.num_balls.setRange(1, 1000)
        self.num_balls.setValue(DEFAULT_NUM_BALLS)
        self.num_balls.setKeyboardTracking(False)
        row(form, "Number of balls:", self.num_balls, BEARING_DOCS["NumBalls"])

        # Cage options (checkable group = "create cage")
        self.cage = QtGui.QGroupBox("Cage")
        self.cage.setCheckable(True)
        self.cage.setChecked(True)
        cform = QtGui.QFormLayout(self.cage)
        self.cage_t = spin(CAGE_DEFAULTS["CageThickness"], prefix="")
        self.cage_top = spin(CAGE_DEFAULTS["CageTopOffset"], prefix="")
        self.pocket_clr = spin(CAGE_DEFAULTS["PocketClearance"], prefix="")
        self.pocket_rise = spin(CAGE_DEFAULTS["PocketRise"], prefix="")
        row(cform, "Cage thickness:", self.cage_t, CAGE_DOCS["CageThickness"])
        row(cform, "Cage top offset:", self.cage_top, CAGE_DOCS["CageTopOffset"])
        row(cform, "Pocket clearance:", self.pocket_clr, CAGE_DOCS["PocketClearance"])
        row(cform, "Pocket rise:", self.pocket_rise, CAGE_DOCS["PocketRise"])
        row(form, None, self.cage, UI_HELP["Cage"])

        self.balls = QtGui.QCheckBox("Create balls")
        self.balls.setChecked(False)
        row(form, "Balls:", self.balls, UI_HELP["Balls"])

        self.show_preview = QtGui.QCheckBox("Show preview")
        self.show_preview.setChecked(True)
        row(form, "", self.show_preview, UI_HELP["Preview"])
        # what is wrong with the current values, if anything (OK refuses them too)
        self.status = QtGui.QLabel()
        self.status.setWordWrap(True)
        self.status.setStyleSheet("color: #d03030;")
        form.addRow(self.status)

        Preview.clear_stale()
        self.preview = Preview()
        # however the panel goes away (OK, Cancel, another task replacing it, document
        # closed), its preview goes with it
        self.form.destroyed.connect(self.preview.clear)
        self._preview_timer = QtCore.QTimer()
        self._preview_timer.setSingleShot(True)
        self._preview_timer.setInterval(120)  # coalesce bursts of edits (spin box arrows)
        self._preview_timer.timeout.connect(self.values_changed)

        self.mode.currentIndexChanged.connect(self.refresh)
        self.edge_is.currentIndexChanged.connect(self.refresh)
        for s in (self.id_, self.od, self.height):
            s.valueChanged.connect(self.sync_size)
        self.size.currentIndexChanged.connect(self.apply_size)
        self.ball_preset.currentIndexChanged.connect(self.apply_ball_preset)
        self.ball.valueChanged.connect(self.sync_ball_preset)

        for w in (
            self.id_,
            self.od,
            self.height,
            self.ball,
            self.cage_t,
            self.cage_top,
            self.pocket_clr,
            self.pocket_rise,
        ):
            w.valueChanged.connect(self.schedule_preview)
        self.num_balls.valueChanged.connect(self.schedule_preview)
        for w in (self.mode, self.edge_is):
            w.currentIndexChanged.connect(self.schedule_preview)
        for w in (self.reverse, self.show_preview):
            w.toggled.connect(self.schedule_preview)
        self.cage.toggled.connect(self.schedule_preview)

        self.refresh()
        self.values_changed()

    # ------------------------------------------------------------ preview

    def schedule_preview(self, *_):
        self._preview_timer.start()

    def values_changed(self):
        self.update_status()
        self.update_preview()

    def update_status(self):
        """Say what is wrong with the values. Ball and cage sizes are never changed for
        the user: they keep their defaults (or what was typed) until edited."""
        o = self.options()
        try:
            validate(o["values"], o["cage"], o["balls"])
            self.status.setText("")
            self.status.setVisible(False)
        except ValueError as e:
            self.status.setText(str(e))
            self.status.setVisible(True)

    def update_preview(self):
        if not self.show_preview.isChecked():
            self.preview.clear()
            return
        o = self.options()
        frame = preview_frame(
            o["mode"], self.edge, self.measured, o["values"]["Height"], o["reverse"]
        )
        try:
            self.preview.show(frame, o["values"], o["cage"])
        except Exception as e:  # a preview problem must never block the panel
            App.Console.PrintLog("Bearing preview: %s\n" % e)
            self.preview.clear()

    # ------------------------------------------------------------ catalog size / presets

    def fill_sizes(self):
        """Catalog sizes that fit the locked diameter (all of them without an edge)."""
        self.size.blockSignals(True)
        self.size.clear()
        self.size.addItem(CUSTOM)
        locked = self.locked_diameter()
        for name, d, D, B in catalog_rows():
            if locked is not None:
                key, dia = locked
                if abs((d if key == "ID" else D) - dia) > 1e-6:
                    continue
            self.size.addItem("%s  (%gx%gx%g)" % (name, d, D, B), (d, D, B))
        self.size.blockSignals(False)
        self.sync_size()

    def locked_diameter(self):
        """("ID" or "OD", diameter) taken from the selected edge, or None."""
        if not self.edge:
            return None
        return ("ID" if self.edge_is.currentIndex() == 0 else "OD"), self.edge_dia

    def apply_size(self, index):
        data = self.size.itemData(index)
        if not data:
            return
        # with an edge, the list only holds sizes whose locked diameter matches it
        d, D, B = data
        self.id_.setValue(d)
        self.od.setValue(D)
        self.height.setValue(B)

    def sync_size(self, *_):
        """Show the catalog size matching the current ID x OD x Height, or Custom."""
        v = {"ID": self.id_.value(), "OD": self.od.value(), "Height": self.height.value()}
        name = catalog_match(v, tol=5e-3)
        index = 0
        for i in range(1, self.size.count()):
            if self.size.itemText(i).split()[0] == name:
                index = i
                break
        self.size.blockSignals(True)
        self.size.setCurrentIndex(index)
        self.size.blockSignals(False)

    def apply_ball_preset(self, index):
        dia = self.ball_preset.itemData(index)
        if dia:
            self.ball.setValue(dia)

    def sync_ball_preset(self, *_):
        index = 0
        for i in range(1, self.ball_preset.count()):
            if abs(self.ball_preset.itemData(i) - self.ball.value()) < 5e-3:
                index = i
                break
        self.ball_preset.blockSignals(True)
        self.ball_preset.setCurrentIndex(index)
        self.ball_preset.blockSignals(False)

    # ------------------------------------------------------------ dialog logic

    def refresh(self, *_):
        groove = self.mode.currentText() == GROOVE
        mode_changed = self._mode != self.mode.currentText()
        self._mode = self.mode.currentText()
        m = self.measured

        if mode_changed and self.edge:
            # Each mode starts from its own defaults
            self.edge_is.blockSignals(True)
            inner_default = m["is_inner"] if groove else self.create_inner
            self.edge_is.setCurrentIndex(0 if inner_default else 1)
            self.edge_is.blockSignals(False)
            if groove:
                self.height.setValue(m["height"])
            else:
                self.height.setValue(DEFAULT_HEIGHT)

        # Grooving the body: which diameter the edge is was detected
        self.edge_is.setEnabled(not groove)
        self.reverse.setEnabled(not groove)
        self.size.setEnabled(not groove)

        inner = self.edge_is.currentIndex() == 0
        locked, other = (self.id_, self.od) if inner else (self.od, self.id_)
        other.setEnabled(True)
        if self.edge:
            # The selected edge fixes one diameter
            locked.setValue(self.edge_dia)
            locked.setEnabled(False)
            # The other diameter starts 15 mm away (both modes); afterwards it is only
            # reset when it ends up on the wrong side of the locked one
            if (
                mode_changed
                or (inner and self.od.value() <= self.edge_dia)
                or (not inner and self.id_.value() >= self.edge_dia)
            ):
                other.setValue(other_diameter(self.edge_dia, inner))
        else:
            locked.setEnabled(True)

        self.fill_sizes()

    def options(self):
        return {
            "mode": self.mode.currentText(),
            "is_inner": self.edge_is.currentIndex() == 0,
            "reverse": self.reverse.isChecked(),
            "cage": self.cage.isChecked(),
            "balls": self.balls.isChecked(),
            "values": {
                "ID": self.id_.value(),
                "OD": self.od.value(),
                "Height": self.height.value(),
                "BallDiameter": self.ball.value(),
                "NumBalls": self.num_balls.value(),
                "CageThickness": self.cage_t.value(),
                "CageTopOffset": self.cage_top.value(),
                "PocketClearance": self.pocket_clr.value(),
                "PocketRise": self.pocket_rise.value(),
            },
        }

    # ------------------------------------------------------------ task panel protocol

    def getStandardButtons(self):
        return QtGui.QDialogButtonBox.Ok | QtGui.QDialogButtonBox.Cancel  # no int(): PySide6 enums

    def accept(self):
        """Check the values first; on a problem, say so and keep the panel open."""
        o = self.options()
        try:
            validate(o["values"], o["cage"], o["balls"])
        except ValueError as e:
            QtGui.QMessageBox.warning(self.form, TITLE, str(e))
            return False
        self._preview_timer.stop()
        self.preview.clear()
        if self.build(o):
            Gui.Control.closeDialog()
            return True
        self.update_preview()
        return False

    def reject(self):
        self._preview_timer.stop()
        self.preview.clear()
        Gui.Control.closeDialog()
        return True

    def build(self, opts):
        """Create the bearing from the panel's options. Returns False on failure."""
        if self.feature is not None:
            doc = self.feature.Document
        else:
            doc = App.ActiveDocument or App.newDocument("Bearing")
        split = True
        doc.openTransaction("Deep groove ball bearing")
        try:
            if opts["mode"] == GROOVE:
                before = len(self.body.Shape.Solids)
                groove_body(self.feature, self.edge, opts["values"], opts["cage"], opts["balls"])
                split = len(self.body.Shape.Solids) > before
            else:
                placement = frame_placement(self.edge) if self.edge else App.Placement()
                create_races(
                    doc, placement, opts["values"], opts["reverse"], opts["cage"], opts["balls"]
                )
        except Exception as e:
            doc.abortTransaction()
            App.Console.PrintError(str(e) + "\n")
            QtGui.QMessageBox.warning(Gui.getMainWindow(), TITLE, str(e))
            return False
        doc.commitTransaction()
        if Gui.ActiveDocument and Gui.ActiveDocument.ActiveView:
            # SendMsgToActiveView("ViewFit") is gone in FreeCAD 1.1
            Gui.ActiveDocument.ActiveView.fitAll()
        if not split:
            msg = (
                "The groove did not split the body into separate inner and outer races. "
                "Check the diameters and the height (the groove must cut through the body), "
                "or edit them on BearingParameters."
            )
            App.Console.PrintWarning(msg + "\n")
            QtGui.QMessageBox.warning(Gui.getMainWindow(), TITLE, msg)
        return True


def get_selection():
    """Return (feature, global edge, global shape) for one selected circular edge, or
    None for no selection."""
    import FreeCADGui as Gui

    # Resolve mode 0 gives the full selection path, so the edge is in global coordinates
    sel = Gui.Selection.getSelectionEx("", 0)
    if not sel:
        return None
    if len(sel) != 1 or len(sel[0].SubElementNames) != 1:
        raise ValueError(
            "Select exactly one circular edge (or nothing, to create races at the origin)."
        )
    top, subname = sel[0].Object, sel[0].SubElementNames[0]
    if not subname.split(".")[-1].startswith("Edge"):
        raise ValueError("The selection must be an edge.")
    # edge and shape share topology, so faces adjacent to the edge can be found
    edge, shape = resolve_edge(top, subname)
    if edge is None:
        raise ValueError("The selected edge is not circular.")
    return owner_object(top, subname), edge, shape


def run_gui():
    """Read the selection and show the task panel. Returns the panel (or None)."""
    import FreeCADGui as Gui
    from PySide import QtGui

    def fail(msg):
        App.Console.PrintError(msg + "\n")
        QtGui.QMessageBox.warning(Gui.getMainWindow(), TITLE, msg)

    if Gui.Control.activeDialog():
        return fail("Close the open task panel first.")
    try:
        picked = get_selection()
    except ValueError as e:
        return fail(str(e))
    feature, edge, shape = picked if picked else (None, None, None)

    # "Groove selected body" only when the edge is on a PartDesign body we can measure
    measured = None
    body = find_body(feature) if feature is not None else None
    if body is not None:
        try:
            measured = measure_body(body, edge)
        except ValueError:
            measured = None
    # Creating races: the end of a shaft is the bearing's ID, a housing bore its OD
    create_inner = edge_side(shape, edge) != "outside" if shape is not None else True
    # The races are padded along the circle axis, whose sign is arbitrary: preset Reverse
    # so they go into the hole / onto the shaft (away from the face's outward normal)
    reverse = False
    if edge is not None and shape is not None:
        axis = App.Vector(edge.Curve.Axis)
        reverse = axis.dot(outward_normal(shape, edge)) > 0
    panel = TaskPanel(edge, measured, create_inner, reverse=reverse, feature=feature, body=body)
    Gui.Control.showDialog(panel)
    return panel


if App.GuiUp:
    run_gui()
